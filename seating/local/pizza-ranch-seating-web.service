[Unit]
Description=Pizza Ranch local seating HTTPS
After=network.target

[Service]
User=pr-seating-web
Group=pr-seating-web
ExecStart=/opt/pizza-ranch-seating/web/usr/bin/caddy run --config /etc/pizza-ranch-seating/Caddyfile --adapter caddyfile
Environment=HOME=/var/lib/pizza-ranch-seating-web
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pizza-ranch-seating-web

[Install]
WantedBy=multi-user.target
